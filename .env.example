# Copy to .env and fill in your Hyperline API keys.
# Active environment: test (sandbox) or prod
HYPERLINE_ENV=test

HYPERLINE_API_KEY_TEST=test_your_sandbox_key
HYPERLINE_BASE_URL_TEST=https://sandbox.api.hyperline.co

HYPERLINE_API_KEY_PROD=prod_your_production_key
HYPERLINE_BASE_URL_PROD=https://api.hyperline.co
