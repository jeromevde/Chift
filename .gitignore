.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv/
uv.lock
dist/
*.egg-info/
.DS_Store
generated/hyperline/.ruff_cache/
experiments/**/sdks/

# Disposable packages generated by `pytest --robustness`.
generated/_robustness/

# Held by a running generator, so two runs never write the same provider at once.
providers/*/.generator.lock

# The run before the latest, kept by the generator in case it was not committed.
providers/*/generated.previous/

# Per-run test outputs, timestamped; report.md summarises them.
providers/*/generated/logs/tests-*.json
